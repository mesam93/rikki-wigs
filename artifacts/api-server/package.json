{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:google-auth": "esbuild src/auth/google-policy.test.ts src/auth/google-routes.test.ts --bundle --platform=node --format=cjs --external:google-auth-library --outdir=dist/auth-tests --out-extension:.js=.cjs && node --test dist/auth-tests/*.test.cjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "import:wig-orders": "esbuild src/scripts/import-wig-orders-once.ts --bundle --platform=node --format=cjs --outfile=dist/import-wig-orders-once.cjs && node dist/import-wig-orders-once.cjs",
    "test:email": "esbuild src/email/appointment-emails.test.ts src/email/direct-gmail.test.ts --bundle --platform=node --format=cjs --outdir=/tmp/rikki-email-tests --out-extension:.js=.cjs && node --test /tmp/rikki-email-tests/appointment-emails.test.cjs /tmp/rikki-email-tests/direct-gmail.test.cjs",
    "test:calendar": "esbuild src/lib/calendar-time.test.ts src/lib/calendar-config.test.ts src/lib/direct-calendar.test.ts src/lib/calendar-safety.test.ts --bundle --platform=node --format=cjs --outdir=/tmp/rikki-calendar-tests --out-extension:.js=.cjs && NODE_ENV=production node --test /tmp/rikki-calendar-tests/calendar-time.test.cjs /tmp/rikki-calendar-tests/calendar-config.test.cjs /tmp/rikki-calendar-tests/direct-calendar.test.cjs /tmp/rikki-calendar-tests/calendar-safety.test.cjs",
    "test:receipt": "node ./build.mjs --receipt-test && node --test ./dist/wig-receipt-pdf.test.mjs",
    "test:frontend": "esbuild src/lib/serve-frontend.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/rikki-serve-frontend.test.cjs && node --test /tmp/rikki-serve-frontend.test.cjs",
    "test:client": "esbuild src/lib/client-identity.test.ts --bundle --platform=node --format=cjs --outfile=dist/client-identity.test.cjs && node --test dist/client-identity.test.cjs",
    "test:storage": "esbuild src/lib/galleryStorage.test.ts --bundle --packages=external --platform=node --format=cjs --outfile=dist/gallery-storage.test.cjs && node --test dist/gallery-storage.test.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@google-cloud/storage": "^8.1.0",
    "@replit/connectors-sdk": "^0.4.3",
    "@swc/helpers": "^0.5.23",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.1.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
